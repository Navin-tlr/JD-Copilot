# LLM API Keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (recommended for production)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=x-ai/grok-4-fast

# Alternative LLM Providers
GEMINI_API_KEY=
GEMINI_MODEL=Gemini-2.5-pro

# Document Processing
LLAMAPARSE_API_KEY=

# Vector Database (Pinecone - cloud-first)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=jd-copilot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking Settings
CHUNK_SIZE=700
CHUNK_OVERLAP=150

# Database
DATABASE_PATH=data/placement_data.db

# Data Directories
DATA_DIR=data
DOCLING_JSON_DIR=data/docling_json
LANGEXT_JSON_DIR=data/langext_json
LANGEXT_HTML_DIR=data/langext_html
DOCLING_MODELS_DIR=data/docling_models
CHROMA_DIR=data/chroma


