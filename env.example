# LLM API Keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (recommended primary LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter is optional and disabled by default. If you want to use OpenRouter,
# set the values below. Leaving these blank will force the system to use Gemini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Alternative LLM Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Document Processing
LLAMAPARSE_API_KEY=

# Vector Database (Pinecone - cloud-first)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=jd-copilot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings
EMBED_MODEL=openai/text-embedding-3-large

# Chunking Settings
CHUNK_SIZE=700
CHUNK_OVERLAP=150

# Database
DATABASE_PATH=data/placement_data.db

# Data Directories
DATA_DIR=data
DOCLING_JSON_DIR=data/docling_json
LANGEXT_JSON_DIR=data/langext_json
LANGEXT_HTML_DIR=data/langext_html
DOCLING_MODELS_DIR=data/docling_models
CHROMA_DIR=data/chroma


# Chat behavior toggles
# When set to 1 (default), conversational memory is disabled and each question is treated standalone
DISABLE_CONTEXT_MEMORY=1
# Timeout in seconds for the adaptive workflow before falling back to orchestrator (default 3.0)
ADAPTIVE_WORKFLOW_TIMEOUT=3.0


